# Servidor. 0.0.0.0 permite recibir conexiones desde el teléfono en la LAN.
FOTOSEARCH_HOST=0.0.0.0
FOTOSEARCH_PORT=8000
FOTOSEARCH_LOG_LEVEL=info
FOTOSEARCH_RELOAD=false
# Para producción, limita los orígenes separados por coma. En local, * funciona.
FOTOSEARCH_CORS_ORIGINS=*

# Ruta absoluta o relativa al directorio desde donde arranca el backend.
# Si se omite, se usa Backend/data/fotosearch.db de forma estable.
# FOTOSEARCH_DB=C:/ruta/a/fotosearch.db

# Procesamiento de imágenes y modelos.
FOTOSEARCH_CLIP_MODEL=clip-ViT-B-32
# Encoder de texto compatible con el CLIP visual anterior; cubre 50+ idiomas.
FOTOSEARCH_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
FOTOSEARCH_EMBEDDING_VERSION=clip-b32-multilingual-v2
FOTOSEARCH_QUERY_PIPELINE_VERSION=query-v4-compositional
FOTOSEARCH_FACE_EMBEDDING_VERSION=facenet-vggface2-v1
# Mejora opcional. Requiere requirements-translation.txt e Internet; nunca es crítica.
FOTOSEARCH_TRANSLATION_ENABLED=false
FOTOSEARCH_TRANSLATION_TIMEOUT_SECONDS=2.0
FOTOSEARCH_MAX_IMAGE_SIDE=768
FOTOSEARCH_EMBEDDING_BATCH_SIZE=48
FOTOSEARCH_ENABLE_FACE_RECOGNITION=true
# auto, cpu o cuda:0
FOTOSEARCH_FACE_DEVICE=auto

# Ranking y límites de respuesta.
FOTOSEARCH_SEMANTIC_CANDIDATES=100
FOTOSEARCH_SEMANTIC_WEIGHT=1.0
# Solo se usan para consultas con objeto + color detectables. El retrieval CLIP
# sigue usando las variantes conjuntas y el ajuste ocurre sobre el Top 100.
FOTOSEARCH_COMPOSITIONAL_JOINT_WEIGHT=0.70
FOTOSEARCH_COMPOSITIONAL_COVERAGE_WEIGHT=0.30
FOTOSEARCH_COMPOSITIONAL_COLOR_COMPETITION_WEIGHT=0.10
FOTOSEARCH_IDENTITY_WEIGHT=0.08
FOTOSEARCH_CONCEPT_WEIGHT=0.10
FOTOSEARCH_FACE_THRESHOLD=0.68
FOTOSEARCH_QUERY_FEEDBACK_SIMILARITY_THRESHOLD=0.80
FOTOSEARCH_IMAGE_FEEDBACK_SIMILARITY_THRESHOLD=0.80
FOTOSEARCH_FEEDBACK_MAX_EXAMPLES=3
FOTOSEARCH_GENERAL_FEEDBACK_MAX_BOOST=0.05
FOTOSEARCH_GENERAL_FEEDBACK_MAX_PENALTY=-0.05
FOTOSEARCH_EXACT_POSITIVE_BOOST=0.08
FOTOSEARCH_EXACT_NEGATIVE_PENALTY=-0.10
FOTOSEARCH_CORRECTION_POSITIVE_BOOST=0.10
FOTOSEARCH_SEARCH_CONFIDENCE_THRESHOLD=0.22
FOTOSEARCH_DEFAULT_SEARCH_LIMIT=20
FOTOSEARCH_MAX_SEARCH_LIMIT=100
